# Copy to .env and edit. Every setting is optional; the defaults run the full demo offline.

# Where the dashboard finds the API
STEPGUARD_BACKEND_URL=http://127.0.0.1:8000
STEPGUARD_API_HOST=127.0.0.1
STEPGUARD_API_PORT=8000

# Storage locations (relative paths are resolved from the project root)
# STEPGUARD_DB_PATH=stepguard.db
# STEPGUARD_RESULTS_DIR=results
# STEPGUARD_REPORTS_DIR=reports
# STEPGUARD_LOG_PATH=logs/stepguard.log
# STEPGUARD_SANDBOX_DIR=.sandbox

# Virtual cost model used for the execution-time-overhead metric (seconds)
# STEPGUARD_COST_AGENT_STEP=1.0
# STEPGUARD_COST_TOOL_CALL=0.15
# STEPGUARD_COST_STATE_READ=0.05
# STEPGUARD_COST_SNAPSHOT=0.01
# STEPGUARD_COST_BACKOFF=0.5

# Optional LLM agent (any OpenAI-compatible /chat/completions endpoint, e.g. a local Ollama server).
# Leave empty to use only the deterministic rule-based agent. The key is never logged.
STEPGUARD_LLM_BASE_URL=
STEPGUARD_LLM_MODEL=
STEPGUARD_LLM_API_KEY=
